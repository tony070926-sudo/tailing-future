{
  "name": "tailing-future",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint app lib scripts eslint.config.mjs next.config.ts vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:js && npm run test:python",
    "test:js": "vitest run --config vitest.config.ts",
    "test:python": "python3 -m unittest discover -s scripts/atomistic -p '*_test.py' && python3 scripts/safe_extract_zip_test.py",
    "test:watch": "vitest --config vitest.config.ts",
    "atomistic:validate": "node scripts/validate-atomistic-plan.mjs",
    "atomistic:fetch": "node scripts/atomistic/fetch-assets.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "release:manifest": "node scripts/release-artifact.mjs create",
    "check": "npm run lint && npm run typecheck && npm run test && npm run atomistic:validate && npm run evaluate && npm run build",
    "deploy:cloudflare": "node scripts/release-cloudflare.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/workers-types": "5.20260828.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "ajv": "8.20.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "js-yaml": "4.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
