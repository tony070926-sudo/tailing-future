{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailing.future/schemas/atomistic-full-candidate-determinism-roots/0.1",
  "title": "Tailing Future atomistic full-candidate scientific/provenance root contract",
  "description": "Closed, fixture-only and dispatch-disabled rules for separate canonical scientific and execution-provenance roots. This contract does not report a model execution or scientific result.",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "frozenAt",
    "hypothesisId",
    "purpose",
    "observerBoundary",
    "inputContract",
    "scientificProjection",
    "provenanceProjection",
    "canonicalization",
    "modelBindings",
    "quantityContract",
    "comparisonPolicy",
    "applicability",
    "claims"
  ],
  "properties": {
    "schemaVersion": { "const": "tf.atomistic-full-candidate-determinism-roots/0.1" },
    "status": { "const": "fixture-only-dispatch-disabled" },
    "frozenAt": { "const": "2026-09-07" },
    "hypothesisId": { "const": "H-vNext-Scientific-Provenance-Roots/0.1" },
    "purpose": { "type": "string", "minLength": 64, "maxLength": 512 },
    "observerBoundary": {
      "type": "object",
      "required": ["path", "schemaVersion", "rawDigest", "extendedWithoutReinterpretation"],
      "properties": {
        "path": { "const": "evaluation/atomistic/full-candidate-observer-contract-vnext.json" },
        "schemaVersion": { "const": "tf.atomistic-full-candidate-observer-contract/0.1" },
        "rawDigest": { "const": "sha256:9fd93ded20bd013a0c6d61dfec48368fc7957725ee4f95f4fafa242c7f7f0759" },
        "extendedWithoutReinterpretation": { "const": true }
      },
      "additionalProperties": false
    },
    "inputContract": { "$ref": "#/$defs/inputContract" },
    "scientificProjection": { "$ref": "#/$defs/scientificProjection" },
    "provenanceProjection": { "$ref": "#/$defs/provenanceProjection" },
    "canonicalization": {
      "const": {
        "encoding": "recursive-lexicographic-object-key-json-utf8-plus-one-lf/v1",
        "root": "sha256-over-exact-canonical-bytes/v1",
        "signedZeroNormalization": "every-negative-zero-number-to-positive-zero-before-encoding/v1",
        "arraysOrdered": true,
        "objectKeysSortedLexicographically": true,
        "schemaVersionCommittedInEachProjection": true
      }
    },
    "modelBindings": {
      "const": {
        "runnerSha256": "sha256:d6e83640f15926088c116312c27605570f9e9c8ba4e9a9988ef5bf4d3a974ed4",
        "models": [
          {
            "model": "mattersim",
            "modelId": "mattersim-v1.0.0-5m",
            "checkpointSha256": "sha256:e3df9fa708725e3d453140646c7d1838324b347a3d1214cf1440522146f872b5",
            "packageSha256": "sha256:1b5e46ba56efa5c1e93372ad32321300fa5e1f07dd9188a11b727bd578cf8d7f",
            "adapter": "mattersim-ase-batch1-full3x3-eva3/v1",
            "dependencyLockSha256": "sha256:9c990909d1307bb32608d31b9ed217d2368c28e2048f6dec39e8dc4a2b63642b"
          },
          {
            "model": "mace",
            "modelId": "mace-mpa-0-medium",
            "checkpointSha256": "sha256:75428afe3a1d7d8062e19bcaabd5c433623cabf308242ec9fb493e38604fb638",
            "packageSha256": "sha256:b80407edf6b2a1ec8523668c2a36852d20927ce1c3c56b70983a9f2dc53233ad",
            "adapter": "mace-ase-batch1-full3x3-eva3/v1",
            "dependencyLockSha256": "sha256:ae4b21b6f6d8ad98edcf2d5e0d938cd563379f494cce0b4aaa2e987332147e33"
          }
        ]
      }
    },
    "quantityContract": { "$ref": "#/$defs/quantityContract" },
    "comparisonPolicy": {
      "const": {
        "sameModelAuthoritativeRepeatScientificBytesMustMatch": true,
        "sameModelAuthoritativeRepeatScientificRootsMustMatch": true,
        "freshContainerProvenanceBytesMustDiffer": true,
        "freshContainerProvenanceRootsMustDiffer": true,
        "freshContainerIdsMustDiffer": true,
        "freshNetworkNamespaceIdentitiesMustDiffer": true,
        "numericToleranceAllowed": false,
        "mismatchDisposition": "fail-closed-no-repeat-replacement/v1"
      }
    },
    "applicability": {
      "type": "object",
      "required": ["systemBoundary", "horizon", "modelBoundary", "excludedRegimes"],
      "properties": {
        "systemBoundary": { "const": "one static 16-atom three-dimensionally periodic Random-TP frame per prediction" },
        "horizon": { "const": "single-point-no-dynamics-or-future-rollout" },
        "modelBoundary": { "const": "the two byte-frozen MatterSim and MACE lanes only" },
        "excludedRegimes": {
          "const": [
            "cross-runner-bit-exactness",
            "probe-record-determinism",
            "reference-label-values",
            "uncertainty-calibration",
            "dynamics-or-future-state",
            "causal-or-counterfactual-effects",
            "real-material-or-industrial-validation"
          ]
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "const": {
        "modelExecutionObserved": false,
        "scientificValidationComplete": false,
        "reproduced": false,
        "comparisonEligible": false,
        "promotionEligible": false,
        "publicationEligible": false,
        "dispatchEligible": false,
        "causalClaimAllowed": false,
        "industrialFitness": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "countQuantity": {
      "type": "object",
      "required": ["value", "unit", "dimension", "basis"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dimension": { "const": "count" },
        "basis": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "byteQuantity": {
      "type": "object",
      "required": ["value", "unit", "dimension", "basis"],
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "unit": { "const": "byte" },
        "dimension": { "const": "information-size" },
        "basis": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "inputContract": {
      "type": "object",
      "required": [
        "predictionSchemaVersion",
        "executionProvenanceSchemaVersion",
        "records",
        "atomsPerRecord",
        "predictionRecordFields",
        "executionProvenanceFields",
        "environmentBindingFields",
        "containerIdentityFields",
        "networkProofFields",
        "networkProbeFields",
        "hostObservationFields",
        "environmentBindingFixedValues",
        "recordOrder",
        "duplicateJsonMembersAllowed",
        "duplicateRecordIdsAllowed",
        "missingFieldsAllowed",
        "extraFieldsAllowed",
        "nonfiniteNumbersAllowed",
        "maximumPredictionJsonlBytes",
        "maximumExecutionProvenanceBytes"
      ],
      "properties": {
        "predictionSchemaVersion": { "const": "tf.atomistic-prediction/0.3" },
        "executionProvenanceSchemaVersion": { "const": "tf.atomistic-full-candidate-execution-provenance/0.1" },
        "records": {
          "allOf": [
            { "$ref": "#/$defs/countQuantity" },
            { "type": "object", "properties": { "value": { "const": 693 } } }
          ]
        },
        "atomsPerRecord": {
          "allOf": [
            { "$ref": "#/$defs/countQuantity" },
            { "type": "object", "properties": { "value": { "const": 16 } } }
          ]
        },
        "predictionRecordFields": {
          "const": [
            "schemaVersion",
            "id",
            "inputStructureDigest",
            "atomCount",
            "atomicNumbers",
            "modelId",
            "checkpointSha256",
            "packageSha256",
            "runnerSha256",
            "environmentSha256",
            "status",
            "energyEv",
            "forcesEvPerAngstrom",
            "stressAseEvPerAngstrom3"
          ]
        },
        "executionProvenanceFields": {
          "const": [
            "schemaVersion",
            "environmentBinding",
            "environmentSha256",
            "hostObservation"
          ]
        },
        "environmentBindingFields": {
          "const": [
            "planSha256",
            "runnerSha256",
            "pythonVersion",
            "pythonImplementation",
            "system",
            "machine",
            "device",
            "dtype",
            "batchSize",
            "threads",
            "adapter",
            "numpyVersion",
            "torchVersion",
            "installedDistributionsSha256",
            "dependencyLockSha256",
            "containerIdentity",
            "executionIdentityComplete",
            "workflowRevision",
            "runtimeSourceRevision",
            "evidenceClass",
            "promotionEligible",
            "comparable",
            "reproduced",
            "structureBundleSha256",
            "structureManifestFileSha256",
            "networkProofStart",
            "networkProofEnd"
          ]
        },
        "containerIdentityFields": { "const": ["kind", "configImageId", "scope", "promotionTrustRoot", "registryManifestDigest"] },
        "networkProofFields": { "const": ["egress_disabled", "network_namespace", "effective_capabilities", "interfaces", "ipv4_routes", "ipv6_routes", "probes", "escape_sockets_absent", "method"] },
        "networkProbeFields": { "const": ["family", "address", "port", "blockedErrno", "blockedReason"] },
        "hostObservationFields": {
          "const": [
            "imageConfigDigest",
            "containerId",
            "networkNamespaceIdentity"
          ]
        },
        "environmentBindingFixedValues": {
          "const": {
            "planSha256": "sha256:d3a58524029b51c598d00a7bb9f60b6479a9973a0f9907cbf94a31e61bf1c9c2",
            "runnerSha256": "sha256:d6e83640f15926088c116312c27605570f9e9c8ba4e9a9988ef5bf4d3a974ed4",
            "pythonVersion": "3.12.13",
            "pythonImplementation": "CPython",
            "system": "Linux",
            "machine": "x86_64",
            "device": "cpu",
            "dtype": "float32",
            "batchSize": 1,
            "threads": 1,
            "numpyVersion": "2.5.2",
            "torchVersion": "2.8.0+cpu",
            "executionIdentityComplete": true,
            "evidenceClass": "bootstrap-not-reproduced",
            "promotionEligible": false,
            "comparable": false,
            "reproduced": false,
            "structureBundleSha256": "sha256:d4ff1ee210abf80884e1526b1e2600e918103f3505a2a712bce57d6fba3a1b5c",
            "structureManifestFileSha256": "sha256:9f870f62cd60b7021d874d1970c81ac8cb64a302e2c5fd4013464198fd11a25e"
          }
        },
        "recordOrder": { "const": "exact-frozen-random-tp-id-manifest-ascii-order/v1" },
        "duplicateJsonMembersAllowed": { "const": false },
        "duplicateRecordIdsAllowed": { "const": false },
        "missingFieldsAllowed": { "const": false },
        "extraFieldsAllowed": { "const": false },
        "nonfiniteNumbersAllowed": { "const": false },
        "maximumPredictionJsonlBytes": {
          "allOf": [
            { "$ref": "#/$defs/byteQuantity" },
            { "type": "object", "properties": { "value": { "const": 8388608 } } }
          ]
        },
        "maximumExecutionProvenanceBytes": {
          "allOf": [
            { "$ref": "#/$defs/byteQuantity" },
            { "type": "object", "properties": { "value": { "const": 16384 } } }
          ]
        }
      },
      "additionalProperties": false
    },
    "scientificProjection": {
      "type": "object",
      "required": [
        "schemaVersion",
        "topLevelFields",
        "includedRecordFields",
        "excludedProvenancePaths",
        "structureIdentityFields",
        "modelIdentityFields",
        "outputFields",
        "maximumCanonicalBytes"
      ],
      "properties": {
        "schemaVersion": { "const": "tf.atomistic-full-candidate-scientific-projection/0.1" },
        "topLevelFields": { "const": ["schemaVersion", "records"] },
        "includedRecordFields": {
          "const": [
            "schemaVersion",
            "id",
            "inputStructureDigest",
            "atomCount",
            "atomicNumbers",
            "modelId",
            "checkpointSha256",
            "packageSha256",
            "runnerSha256",
            "status",
            "energyEv",
            "forcesEvPerAngstrom",
            "stressAseEvPerAngstrom3"
          ]
        },
        "excludedProvenancePaths": {
          "const": [
            "records[*].environmentSha256",
            "executionProvenance.schemaVersion",
            "executionProvenance.environmentBinding",
            "executionProvenance.environmentSha256",
            "executionProvenance.hostObservation.imageConfigDigest",
            "executionProvenance.hostObservation.containerId",
            "executionProvenance.hostObservation.networkNamespaceIdentity"
          ]
        },
        "structureIdentityFields": { "const": ["id", "inputStructureDigest", "atomCount", "atomicNumbers"] },
        "modelIdentityFields": { "const": ["modelId", "checkpointSha256", "packageSha256", "runnerSha256"] },
        "outputFields": { "const": ["energyEv", "forcesEvPerAngstrom", "stressAseEvPerAngstrom3"] },
        "maximumCanonicalBytes": {
          "allOf": [
            { "$ref": "#/$defs/byteQuantity" },
            { "type": "object", "properties": { "value": { "const": 8388608 } } }
          ]
        }
      },
      "additionalProperties": false
    },
    "provenanceProjection": {
      "type": "object",
      "required": [
        "schemaVersion",
        "topLevelFields",
        "predictionBindingFieldsValidated",
        "environmentBinding",
        "sourceAgreement",
        "containerIdentitySource",
        "networkNamespaceIdentitySource",
        "maximumCanonicalBytes"
      ],
      "properties": {
        "schemaVersion": { "const": "tf.atomistic-full-candidate-provenance-projection/0.1" },
        "topLevelFields": { "const": ["schemaVersion", "scientificRoot", "environmentSha256", "imageConfigDigest", "containerId", "networkNamespaceIdentity"] },
        "predictionBindingFieldsValidated": { "const": ["id", "environmentSha256"] },
        "environmentBinding": { "const": "sha256-over-the-exact-frozen-v2-runner-rich-environment-binding-preimage-without-terminal-lf-must-equal-every-prediction-and-executionProvenance-environmentSha256/v1" },
        "sourceAgreement": { "const": "host-observed-image-config-digest-and-network-namespace-must-equal-the-v2-runner-bound-values-before-projection; container-id-is-host-only/v1" },
        "containerIdentitySource": { "const": "validated-host-lifecycle-observation-not-container-self-report/v1" },
        "networkNamespaceIdentitySource": { "const": "validated-host-observation-and-runner-environment-binding-must-agree/v1" },
        "maximumCanonicalBytes": {
          "allOf": [
            { "$ref": "#/$defs/byteQuantity" },
            { "type": "object", "properties": { "value": { "const": 4096 } } }
          ]
        }
      },
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "required": ["quantity", "unit", "dimension", "basis"],
      "properties": {
        "quantity": { "type": "string", "minLength": 1, "maxLength": 160 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dimension": { "type": "string", "minLength": 1, "maxLength": 64 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "quantityContract": {
      "type": "object",
      "required": ["atomCount", "atomicNumber", "energyEv", "forcesEvPerAngstrom", "stressAseEvPerAngstrom3"],
      "properties": {
        "atomCount": { "$ref": "#/$defs/quantity" },
        "atomicNumber": { "$ref": "#/$defs/quantity" },
        "energyEv": { "$ref": "#/$defs/quantity" },
        "forcesEvPerAngstrom": { "$ref": "#/$defs/quantity" },
        "stressAseEvPerAngstrom3": { "$ref": "#/$defs/quantity" }
      },
      "additionalProperties": false
    }
  }
}
