        { "allOf": [{ "$ref": "#/$defs/stageRecord" }, { "type": "object", "properties": { "stage": { "const": "freeze" } } }] },
        { "allOf": [{ "$ref": "#/$defs/stageRecord" }, { "type": "object", "properties": { "stage": { "const": "cold-install" } } }] },
        { "allOf": [{ "$ref": "#/$defs/stageRecord" }, { "type": "object", "properties": { "stage": { "const": "build" } } }] },
        { "allOf": [{ "$ref": "#/$defs/stageRecord" }, { "type": "object", "properties": { "stage": { "const": "inference" } } }] }
      ],
      "items": false
    },
    "completeStages": {
