          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/partialEvidence" }
        },
        "failure": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/failureEvidence" }
        }
      },
