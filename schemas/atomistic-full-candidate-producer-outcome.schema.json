      "properties": { "outcome": { "const": "cancelled" } }
    },
    "stages": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/stageRecord" }, { "type": "object", "properties": { "stage": { "const": "guard" } } }] },
