{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailing.future/schemas/atomistic-full-candidate-plan/0.2",
  "title": "Tailing Future Atomistic Full Candidate Plan",
  "description": "A frozen, non-promotional 693-by-two candidate evaluation contract. It does not amend or satisfy the formal atomistic reproduction receipt.",
  "type": "object",
  "required": ["schemaVersion", "status", "frozenAt", "purpose", "bindings", "execution", "metrics", "acceptance", "resultPolicy", "claimBoundaries", "scientificGatesPending"],
  "properties": {
