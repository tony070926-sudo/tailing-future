        "profile": { "const": "full-candidate" },
        "mode": { "const": "full" },
        "canonicalDevice": { "const": "cpu" },
        "dtype": { "const": "float32" },
        "batchSize": { "const": 1 },
        "threads": { "const": 1 },
        "networkPolicy": { "const": "fetch-online-build-and-run-offline" },
        "trustedPreprocessorReferenceLabelAccess": { "const": true },
        "modelSandboxReferenceLabelAccess": { "const": false },
        "independentVerifierReferenceLabelAccess": { "const": true },
        "producerScientificPayloadPolicy": {
          "type": "object",
          "required": ["exactPaths", "scientificArtifactUsesExactPayload", "administrativeEvidenceSeparated", "rawDatasetIncluded", "structureBundleIncluded", "referenceLabelsIncluded", "atomicNumbersIncluded", "atomicNumbersPublicationLicenseCleared", "publicationEligible", "structureCommitmentAuthority"],
          "properties": {
            "exactPaths": { "const": ["manifests/structures.manifest.json", "predictions/predictions.jsonl"] },
