            "requiredRecordsPerModel": 693,
            "requiredTotalPredictions": 1386,
            "allowedMissing": 0,
            "allowedExtra": 0,
            "allowedDuplicate": 0,
            "allowedFailed": 0,
            "allowedNonfinite": 0
          }
        },
        "mattersim": {
          "type": "object",
          "required": ["model", "assessment", "conjunction", "targets", "acceptedIntervals", "officialOrBitExactClaimAllowed"],
          "properties": {
            "model": { "const": "mattersim" },
            "assessment": { "const": "protocol-equivalent-model-card-interval-check" },
            "conjunction": { "const": "energy-and-force-and-stress" },
            "targets": { "const": { "energyMaeEvPerAtom": 0.199, "forceVectorMaeEvPerAngstrom": 0.824, "stressFrobeniusMaeGpa": 1.999 } },
            "acceptedIntervals": { "$ref": "#/$defs/metricIntervals" },
            "officialOrBitExactClaimAllowed": { "const": false }
          },
          "additionalProperties": false
        },
        "mace": {
          "const": {
            "model": "mace",
            "assessment": "blind-engineering-baseline",
            "publishedRandomTpTargetAvailable": false,
            "fitOffsetScaleOrSignAfterObservationAllowed": false,
            "superiorityClaimAllowed": false
          }
        }
