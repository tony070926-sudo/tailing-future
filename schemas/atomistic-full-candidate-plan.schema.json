    "status": { "const": "frozen-candidate-contract-not-run" },
    "frozenAt": { "const": "2026-08-30" },
    "purpose": { "type": "string", "minLength": 80 },
    "bindings": { "$ref": "#/$defs/bindings" },
    "execution": { "$ref": "#/$defs/execution" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "resultPolicy": { "$ref": "#/$defs/resultPolicy" },
    "claimBoundaries": { "$ref": "#/$defs/claimBoundaries" },
