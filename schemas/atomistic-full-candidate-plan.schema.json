            "atomicNumbersPublicationLicenseCleared": { "const": false },
            "publicationEligible": { "const": false },
            "structureCommitmentAuthority": { "const": "independent-verifier-derived-from-frozen-raw-dataset" }
          },
          "additionalProperties": false
        },
        "mixedRunAttemptsAllowed": { "const": false },
        "partitioning": {
          "type": "object",
          "required": ["partitionKey", "currentStrategy", "futureShardingPolicy", "partitions"],
          "properties": {
            "partitionKey": { "const": "model" },
            "currentStrategy": { "const": "one-complete-id-set-partition-per-model" },
            "futureShardingPolicy": { "type": "string", "minLength": 80 },
            "partitions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/mattersimPartition" },
                { "$ref": "#/$defs/macePartition" }
              ],
              "items": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
