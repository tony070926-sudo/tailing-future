{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailing.future/schemas/atomistic-full-candidate-observer-contract/0.1",
  "title": "Tailing Future atomistic full-candidate fixture observer contract",
  "description": "An atomistic-only, fixture-only and dispatch-disabled vNext contract. It does not revise the v0.2 full-candidate receipt or any frontend world/action/observation contract.",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "frozenAt",
    "hypothesisId",
    "purpose",
    "predecessor",
    "legacyReceiptBoundary",
    "frontendBoundary",
    "workflow",
    "topology",
    "validation",
    "quantityContract",
    "isolationContract",
    "hostObservationContract",
    "rightsPolicy",
    "outcomePolicy",
    "applicability",
    "publication"
  ],
  "properties": {
    "schemaVersion": { "const": "tf.atomistic-full-candidate-observer-contract/0.1" },
    "status": { "const": "executable-definition-fixture-only-dispatch-disabled" },
    "frozenAt": { "const": "2026-09-04" },
    "hypothesisId": { "const": "H-vNext-Observer/0.1" },
    "purpose": { "type": "string", "minLength": 32, "maxLength": 512 },
    "predecessor": {
      "type": "object",
      "required": ["path", "schemaVersion", "rawDigest"],
      "properties": {
        "path": { "const": "evaluation/atomistic/full-candidate-execution-preflight.json" },
        "schemaVersion": { "const": "tf.atomistic-full-candidate-execution-preflight/0.1" },
        "rawDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "legacyReceiptBoundary": {
      "type": "object",
      "required": ["path", "schemaVersion", "rawDigest", "reinterpreted"],
      "properties": {
        "path": { "const": "schemas/atomistic-full-candidate-receipt.schema.json" },
        "schemaVersion": { "const": "tf.atomistic-full-candidate-receipt/0.2" },
        "rawDigest": { "$ref": "#/$defs/digest" },
        "reinterpreted": { "const": false }
      },
      "additionalProperties": false
    },
    "frontendBoundary": {
      "type": "object",
      "required": ["world", "action", "observation", "migrationAllowed", "frontendIntegrationAllowed"],
      "properties": {
        "world": { "const": "tf.world/0.3" },
        "action": { "const": "tf.action/0.3" },
        "observation": { "const": "tf.observation/0.3" },
        "migrationAllowed": { "const": false },
        "frontendIntegrationAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "workflow": { "$ref": "#/$defs/workflow" },
    "topology": { "$ref": "#/$defs/topology" },
    "validation": { "$ref": "#/$defs/validation" },
    "quantityContract": {
      "type": "object",
      "minProperties": 20,
      "maxProperties": 20,
      "additionalProperties": { "$ref": "#/$defs/quantity" }
    },
    "isolationContract": { "$ref": "#/$defs/isolation" },
    "hostObservationContract": { "$ref": "#/$defs/hostObservation" },
    "rightsPolicy": { "$ref": "#/$defs/rightsPolicy" },
    "outcomePolicy": { "$ref": "#/$defs/outcome" },
    "applicability": { "$ref": "#/$defs/applicability" },
    "publication": { "$ref": "#/$defs/publication" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "quantity": {
      "type": "object",
      "required": ["quantity", "unit", "dimension", "basis"],
      "properties": {
        "quantity": { "type": "string", "minLength": 1, "maxLength": 160 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dimension": { "type": "string", "minLength": 1, "maxLength": 64 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "path",
        "profile",
        "pushBranchesIgnore",
        "pushTagsIgnore",
        "forbiddenEvents",
        "jobCount",
        "allJobGuardsLiteralFalse",
        "workflowPermissionsEmpty",
        "jobPermissionsEmpty",
        "secretsAllowed",
        "artifactUploadAllowed",
        "containerDispatchAllowed",
        "modelInvocationAllowed",
        "fixtureCommand"
      ],
      "properties": {
        "path": { "const": "evaluation/atomistic/full-candidate-observer-vnext.workflow.yml" },
        "profile": { "const": "fixture-only-unreachable-observer/v1" },
        "pushBranchesIgnore": { "const": ["**"] },
        "pushTagsIgnore": { "const": ["**"] },
        "forbiddenEvents": {
          "const": ["workflow_dispatch", "workflow_call", "repository_dispatch", "pull_request", "pull_request_target", "schedule"]
        },
        "jobCount": { "$ref": "#/$defs/countGate" },
        "allJobGuardsLiteralFalse": { "const": true },
        "workflowPermissionsEmpty": { "const": true },
        "jobPermissionsEmpty": { "const": true },
        "secretsAllowed": { "const": false },
        "artifactUploadAllowed": { "const": false },
        "containerDispatchAllowed": { "const": false },
        "modelInvocationAllowed": { "const": false },
        "fixtureCommand": { "const": "node scripts/atomistic/full-candidate-observer-vnext.mjs --emit-fixture" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "sequence",
        "model",
        "modelId",
        "ordinal",
        "role",
        "benchmarkPredictionRecords",
        "invarianceProbeRecords",
        "forceFiniteDifferenceEnergyProbeRecords",
        "stressFiniteDifferenceEnergyProbeRecords",
        "adapterRequests",
        "freshContainerRequired"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0, "maximum": 3 },
        "model": { "enum": ["mattersim", "mace"] },
        "modelId": { "enum": ["mattersim-v1.0.0-5m", "mace-mpa-0-medium"] },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 1 },
        "role": { "enum": ["authoritative", "repeat-validation"] },
        "benchmarkPredictionRecords": { "$ref": "#/$defs/countGate" },
        "invarianceProbeRecords": { "$ref": "#/$defs/countGate" },
        "forceFiniteDifferenceEnergyProbeRecords": { "$ref": "#/$defs/countGate" },
        "stressFiniteDifferenceEnergyProbeRecords": { "$ref": "#/$defs/countGate" },
        "adapterRequests": { "$ref": "#/$defs/countGate" },
        "freshContainerRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "required": [
        "profile",
        "sharedHost",
        "producerJobCount",
        "sequential",
        "requiredFreshContainerExecutions",
        "executionOrder",
        "recordsPerModel",
        "totals",
        "probeRecordsExcludedFromMetricDenominator",
        "probeRecordsExcludedFromDeterminismDenominator",
        "authoritativeExecutionOrdinal",
        "repeatMayReplaceAuthority",
        "independentJobClaimAllowed",
        "independentHardwareClaimAllowed",
        "independentReplicaClaimAllowed"
      ],
      "properties": {
        "profile": { "const": "single-shared-host-sequential-isolated-model-lanes-central-verifier/v1" },
        "sharedHost": { "const": true },
        "producerJobCount": { "$ref": "#/$defs/countGate" },
        "sequential": { "const": true },
        "requiredFreshContainerExecutions": { "$ref": "#/$defs/countGate" },
        "executionOrder": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/execution" }
        },
        "recordsPerModel": {
          "type": "object",
          "required": ["authoritative", "repeatValidation", "metricDenominator", "determinismDenominator"],
          "properties": {
            "authoritative": { "$ref": "#/$defs/countGate" },
            "repeatValidation": { "$ref": "#/$defs/countGate" },
            "metricDenominator": { "$ref": "#/$defs/countGate" },
            "determinismDenominator": { "$ref": "#/$defs/countGate" }
          },
          "additionalProperties": false
        },
        "totals": {
          "type": "object",
          "required": ["authoritativeBenchmarkPredictionRecords", "repeatValidationBenchmarkPredictionRecords", "invarianceProbeRecords", "forceFiniteDifferenceEnergyProbeRecords", "stressFiniteDifferenceEnergyProbeRecords", "adapterRequests"],
          "properties": {
            "authoritativeBenchmarkPredictionRecords": { "$ref": "#/$defs/countGate" },
            "repeatValidationBenchmarkPredictionRecords": { "$ref": "#/$defs/countGate" },
            "invarianceProbeRecords": { "$ref": "#/$defs/countGate" },
            "forceFiniteDifferenceEnergyProbeRecords": { "$ref": "#/$defs/countGate" },
            "stressFiniteDifferenceEnergyProbeRecords": { "$ref": "#/$defs/countGate" },
            "adapterRequests": { "$ref": "#/$defs/countGate" }
          },
          "additionalProperties": false
        },
        "probeRecordsExcludedFromMetricDenominator": { "const": true },
        "probeRecordsExcludedFromDeterminismDenominator": { "const": true },
        "authoritativeExecutionOrdinal": { "const": 0 },
        "repeatMayReplaceAuthority": { "const": false },
        "independentJobClaimAllowed": { "const": false },
        "independentHardwareClaimAllowed": { "const": false },
        "independentReplicaClaimAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "countGate": {
      "type": "object",
      "required": ["value", "unit", "dimension", "basis"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "dimension": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["completeness", "invariancePerModel", "forceFiniteDifferencePerModel", "stressFiniteDifferencePerModel", "stressSymmetry", "determinismPerModel"],
      "properties": {
        "completeness": { "$ref": "#/$defs/completeness" },
        "invariancePerModel": { "$ref": "#/$defs/invariance" },
        "forceFiniteDifferencePerModel": { "$ref": "#/$defs/forceFiniteDifference" },
        "stressFiniteDifferencePerModel": { "$ref": "#/$defs/stressFiniteDifference" },
        "stressSymmetry": {
          "type": "object",
          "required": ["representation", "residual", "absoluteTolerance", "relativeTolerance", "comparison", "symmetrizationBeforeGateAllowed", "appliesToPredictionAndReferenceTensors", "sourceContract"],
          "properties": {
            "representation": { "const": "raw-full-3x3-before-symmetrization-or-unit-conversion" },
            "residual": { "const": "max_i_j_abs(sigma_i_j-sigma_j_i)" },
            "absoluteTolerance": {
              "type": "object",
              "required": ["value", "ieee754Binary64Hex", "unit", "dimension", "basis"],
              "properties": {
                "value": { "const": 1e-10 },
                "ieee754Binary64Hex": { "const": "0x3ddb7cdfd9d7bdbb" },
                "unit": { "const": "eV/angstrom^3" },
                "dimension": { "const": "energy-per-volume" },
                "basis": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "relativeTolerance": {
              "type": "object",
              "required": ["value", "unit", "dimension", "basis"],
              "properties": {
                "value": { "const": 0 },
                "unit": { "const": "1" },
                "dimension": { "const": "dimensionless" },
                "basis": { "const": "no relative relaxation" }
              },
              "additionalProperties": false
            },
            "comparison": { "const": "residual<=absoluteTolerance" },
            "symmetrizationBeforeGateAllowed": { "const": false },
            "appliesToPredictionAndReferenceTensors": { "const": true },
            "sourceContract": {
              "const": {
                "requiredPath": "atoms.calc.results['stress']-immediately-after-calculation-before-Atoms.get_stress-or-any-Voigt-conversion/v1",
                "acceptedRepresentation": "calculator-native-full-3x3-nine-finite-binary64-components",
                "nativeVoigt6Disposition": "raw-symmetry-unavailable-incomplete-abstain",
                "aseAtomsGetStressVoigtFalseAcceptedAsRawSource": false,
                "currentRunnerStatus": "not-wired-policy-and-synthetic-oracle-only-dispatch-blocking"
              }
            }
          },
          "additionalProperties": false
        },
        "determinismPerModel": {
          "type": "object",
          "required": ["authoritativeOrdinal", "repeatOrdinal", "recordsCompared", "sameRunnerRequired", "freshDistinctContainerIdsRequired", "separateWritableOutputsRequired", "canonicalScientificPayloadBytesMustMatch", "canonicalScientificPayloadRootMustMatch", "signedZeroNormalization", "runContainerTimingAndResourceFieldsExcluded", "probeRecordsExcluded", "crossRunnerBitExactRequired", "numericToleranceAllowed", "repeatMayReplaceAuthority"],
          "properties": {
            "authoritativeOrdinal": { "const": 0 },
            "repeatOrdinal": { "const": 1 },
            "recordsCompared": { "$ref": "#/$defs/countGate" },
            "sameRunnerRequired": { "const": true },
            "freshDistinctContainerIdsRequired": { "const": true },
            "separateWritableOutputsRequired": { "const": true },
            "canonicalScientificPayloadBytesMustMatch": { "const": true },
            "canonicalScientificPayloadRootMustMatch": { "const": true },
            "signedZeroNormalization": { "const": "negative-zero-to-zero" },
            "runContainerTimingAndResourceFieldsExcluded": { "const": true },
            "probeRecordsExcluded": { "const": true },
            "crossRunnerBitExactRequired": { "const": false },
            "numericToleranceAllowed": { "const": false },
            "repeatMayReplaceAuthority": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "completeness": {
      "type": "object",
      "required": ["exactIdsPerModelPerExecution", "atomsPerFrame", "allowedMissing", "allowedExtra", "allowedDuplicate", "allowedFailed", "allowedNonfinite", "allowedMalformed", "asciiIdOrderRequired"],
      "properties": {
        "exactIdsPerModelPerExecution": { "$ref": "#/$defs/countGate" },
        "atomsPerFrame": { "$ref": "#/$defs/countGate" },
        "allowedMissing": { "$ref": "#/$defs/countGate" },
        "allowedExtra": { "$ref": "#/$defs/countGate" },
        "allowedDuplicate": { "$ref": "#/$defs/countGate" },
        "allowedFailed": { "$ref": "#/$defs/countGate" },
        "allowedNonfinite": { "$ref": "#/$defs/countGate" },
        "allowedMalformed": { "$ref": "#/$defs/countGate" },
        "asciiIdOrderRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "invariance": {
      "type": "object",
      "required": ["structureIds", "transformations", "requiredCases", "translationFractionalShift", "translationConvention", "permutation", "permutationComparison", "properRotation", "rotationConvention", "rotationComparison", "periodicImageShift", "periodicImageComparison", "maximumEnergyError", "maximumForceVectorError", "maximumStressFrobeniusError", "allCasesMustPass", "dropRetryOrReselectionAllowed"],
      "properties": {
        "structureIds": {
          "const": ["random-TP-000000", "random-TP-000005", "random-TP-000010", "random-TP-000095", "random-TP-000125", "random-TP-000135", "random-TP-000200", "random-TP-000220", "random-TP-000369", "random-TP-000555"]
        },
        "transformations": { "const": ["translation", "permutation", "proper-rotation", "periodic-image"] },
        "requiredCases": { "$ref": "#/$defs/countGate" },
        "translationFractionalShift": {
          "type": "object",
          "required": ["value", "unit", "dimension", "basis"],
          "properties": {
            "value": { "const": [0.173, 0.271, 0.389] },
            "unit": { "const": "1" },
            "dimension": { "const": "dimensionless-fractional-coordinate" },
            "basis": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "translationConvention": { "const": "row-cell-r-prime=r+[0.173,0.271,0.389]@A0-no-wrap-cell-unchanged/v1" },
        "permutation": { "const": "reverse-atom-order/v1" },
        "permutationComparison": { "const": "inverse-permute-forces-energy-and-stress-unchanged/v1" },
        "properRotation": {
          "type": "object",
          "required": ["value", "unit", "dimension", "basis"],
          "properties": {
            "value": { "const": [[0, -1, 0], [1, 0, 0], [0, 0, 1]] },
            "unit": { "const": "1" },
            "dimension": { "const": "dimensionless-linear-transform" },
            "basis": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "rotationConvention": { "const": "column-vector-R-row-positions-and-cell-right-multiply-R-transpose/v1" },
        "rotationComparison": { "const": "force-back=F_rot@R-stress-back=R-transpose@S_rot@R-energy-unchanged/v1" },
        "periodicImageShift": { "const": "zero-based-atom-i-r_i-prime=r_i+A0[i-mod-3]-cell-unchanged-no-wrap/v1" },
        "periodicImageComparison": { "const": "energy-force-and-stress-unchanged/v1" },
        "maximumEnergyError": {
          "const": { "value": 0.0001, "unit": "eV", "dimension": "energy", "basis": "maximum absolute total-energy difference per transformed case" }
        },
        "maximumForceVectorError": {
          "const": { "value": 0.0001, "unit": "eV/angstrom", "dimension": "energy-per-length", "basis": "maximum per-atom Cartesian vector error after preregistered inverse mapping" }
        },
        "maximumStressFrobeniusError": {
          "const": { "value": 0.00001, "unit": "eV/angstrom^3", "dimension": "energy-per-volume", "basis": "maximum full-3x3 Frobenius error after preregistered rotation back" }
        },
        "allCasesMustPass": { "const": true },
        "dropRetryOrReselectionAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "forceFiniteDifference": {
      "type": "object",
      "required": ["requiredElements", "requiredCases", "energyProbesPerCase", "requiredEnergyProbes", "selection", "axisConvention", "displacement", "steps", "centralDifference", "richardson", "absoluteTolerance", "relativeTolerance", "comparison", "allCasesMustPass", "dropRetryOrReselectionAllowed"],
      "properties": {
        "requiredElements": { "$ref": "#/$defs/countGate" },
        "requiredCases": { "$ref": "#/$defs/countGate" },
        "energyProbesPerCase": { "$ref": "#/$defs/countGate" },
        "requiredEnergyProbes": { "$ref": "#/$defs/countGate" },
        "selection": { "const": "for-each-element-in-frozen-set-lexicographically-first-id-containing-element-lowest-zero-based-atom-index-axis-Z-modulo-3/v1" },
        "axisConvention": { "const": "zero-based-x0-y1-z2" },
        "displacement": { "const": "cartesian-coordinate-plus-minus-h-fixed-cell-and-other-coordinates/v1" },
        "steps": {
          "const": { "values": [0.01, 0.005], "unit": "angstrom", "dimension": "length", "basis": "Cartesian plus/minus h at fixed cell and fixed other coordinates" }
        },
        "centralDifference": { "const": "F_h=-(E(q+h)-E(q-h))/(2h)" },
        "richardson": { "const": "F_R=(4F_h_over_2-F_h)/3" },
        "absoluteTolerance": {
          "const": { "value": 0.02, "unit": "eV/angstrom", "dimension": "energy-per-length", "basis": "absolute analytic-component versus Richardson finite-difference residual" }
        },
        "relativeTolerance": {
          "const": { "value": 0.01, "unit": "1", "dimension": "dimensionless", "basis": "multiplier on max absolute analytic and Richardson components" }
        },
        "comparison": { "const": "abs(analytic-F_R)<=absoluteTolerance+relativeTolerance*max(abs(analytic),abs(F_R))" },
        "allCasesMustPass": { "const": true },
        "dropRetryOrReselectionAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "stressFiniteDifference": {
      "type": "object",
      "required": ["structureIds", "voigtModes", "requiredCases", "energyProbesPerCase", "requiredEnergyProbes", "deformation", "coordinateConvention", "strainBasis", "referenceVolume", "strainSteps", "centralDifference", "richardson", "absoluteTolerance", "relativeTolerance", "comparison", "postHocSignSelectionAllowed", "allCasesMustPass", "dropRetryOrReselectionAllowed"],
      "properties": {
        "structureIds": {
          "const": ["random-TP-000000", "random-TP-000005", "random-TP-000010", "random-TP-000095", "random-TP-000125", "random-TP-000135", "random-TP-000200", "random-TP-000220", "random-TP-000369", "random-TP-000555"]
        },
        "voigtModes": { "const": ["xx", "yy", "zz", "yz", "xz", "xy"] },
        "requiredCases": { "$ref": "#/$defs/countGate" },
        "energyProbesPerCase": { "$ref": "#/$defs/countGate" },
        "requiredEnergyProbes": { "$ref": "#/$defs/countGate" },
        "deformation": { "const": "A_plus_minus=A0@(I_plus_minus_hE_mode)" },
        "coordinateConvention": { "const": "fixed-fractional-coordinates" },
        "strainBasis": { "const": "diagonal-one-engineering-shear-symmetric-one-half" },
        "referenceVolume": { "const": "V0=abs(det(A0))" },
        "strainSteps": {
          "const": { "values": [0.002, 0.001], "unit": "1", "dimension": "dimensionless-strain", "basis": "plus/minus engineering strain with one-half off-diagonal shear basis" }
        },
        "centralDifference": { "const": "sigma_h=(E(+h)-E(-h))/(2hV0)" },
        "richardson": { "const": "sigma_R=(4sigma_h_over_2-sigma_h)/3" },
        "absoluteTolerance": {
          "const": { "value": 0.005, "unit": "eV/angstrom^3", "dimension": "energy-per-volume", "basis": "absolute same-sign ASE component versus Richardson energy-derivative residual" }
        },
        "relativeTolerance": {
          "const": { "value": 0.02, "unit": "1", "dimension": "dimensionless", "basis": "multiplier on max absolute analytic and Richardson components" }
        },
        "comparison": { "const": "abs(analytic-sigma_R)<=absoluteTolerance+relativeTolerance*max(abs(analytic),abs(sigma_R))" },
        "postHocSignSelectionAllowed": { "const": false },
        "allCasesMustPass": { "const": true },
        "dropRetryOrReselectionAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "required": ["network", "rootFilesystem", "user", "capabilities", "noNewPrivileges", "hostSocketsMounted", "hostSecretsMounted", "referenceLabelsMounted", "sharedWritableMountBetweenExecutions", "perExecutionWritableOutputDirectoryOnly", "exactArgvMountAndEnvironmentObservationRequired", "hostObservationRequired", "containerSelfReportTrusted", "containerReadDenialProbeRequired", "canaryAbsenceRequiredInEnvironmentStdoutStderrPredictionsAndReceipt", "canonicalDevice", "gpuDeviceRequestsAllowed"],
      "properties": {
        "network": { "const": "none" },
        "rootFilesystem": { "const": "read-only" },
        "user": { "const": "65532:65532" },
        "capabilities": { "const": "drop-all" },
        "noNewPrivileges": { "const": true },
        "hostSocketsMounted": { "const": false },
        "hostSecretsMounted": { "const": false },
        "referenceLabelsMounted": { "const": false },
        "sharedWritableMountBetweenExecutions": { "const": false },
        "perExecutionWritableOutputDirectoryOnly": { "const": true },
        "exactArgvMountAndEnvironmentObservationRequired": { "const": true },
        "hostObservationRequired": { "const": true },
        "containerSelfReportTrusted": { "const": false },
        "containerReadDenialProbeRequired": { "const": true },
        "canaryAbsenceRequiredInEnvironmentStdoutStderrPredictionsAndReceipt": { "const": true },
        "canonicalDevice": { "const": "cpu" },
        "gpuDeviceRequestsAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "hostObservation": {
      "type": "object",
      "required": ["observerClass", "requiredIdentityFields", "requiredObservationCount", "fieldProvenance", "identityAssignmentAuthority", "lifecycleOrdering", "finiteResourceLimitsRequiredBeforeDispatch", "resourceLimitsStatus", "performanceThresholdClaimAllowed", "throughputComparisonClaimAllowed", "durableIndependentAttestationPresent"],
      "properties": {
        "observerClass": { "const": "same-job-label-separated-host-observer-not-independent-job-or-hardware" },
        "requiredIdentityFields": {
          "const": ["repositoryId", "revision", "workflowPath", "workflowBlobDigest", "workflowRunId", "runAttempt", "jobId", "runnerOs", "runnerArchitecture", "runnerImage", "dockerServerVersion", "imagePlatformManifestDigest", "imageConfigDigest", "sequence", "model", "modelId", "ordinal", "role", "containerId", "outputDirectory", "startedAtMonotonicNs", "endedAtMonotonicNs", "exitCode", "argv", "mounts", "environmentKeyAllowlist", "networkMode", "readonlyRootfs", "user", "capDrop", "securityOpt", "cpuQuotaCores", "memoryLimitBytes", "memoryPeakBytes", "pidsLimit", "cpuTimeSeconds"]
        },
        "requiredObservationCount": { "$ref": "#/$defs/countGate" },
        "fieldProvenance": {
