      "properties": {
        "name": { "const": "runtime_contract.py" },
        "sourcePath": { "const": "scripts/atomistic/v2/runtime_contract.py" },
        "buildPath": { "const": "scripts/atomistic/runtime_contract.py" },
        "standardContainerPath": { "const": "/opt/tailing-venv/lib/python3.12/site-packages/runtime_contract.py" },
