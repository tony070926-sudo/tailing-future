      },
      "additionalProperties": false
    },
    "twoModelNullableDigests": {
      "type": "object",
      "required": ["mattersim", "mace"],
      "properties": {
        "mattersim": { "$ref": "#/$defs/nullableDigest" },
        "mace": { "$ref": "#/$defs/nullableDigest" }
      },
      "additionalProperties": false
