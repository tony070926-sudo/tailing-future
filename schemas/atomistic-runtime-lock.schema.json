    "runtimeIdentities": {
      "type": "object",
      "required": ["runnerDigest", "dependencyLockDigests", "runtimeInputManifestDigests", "ociImages"],
      "properties": {
        "runnerDigest": { "$ref": "#/$defs/nullableDigest" },
        "dependencyLockDigests": { "$ref": "#/$defs/twoModelNullableDigests" },
        "runtimeInputManifestDigests": { "$ref": "#/$defs/twoModelNullableDigests" },
