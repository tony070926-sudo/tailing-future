        "chemistry": { "type": "string", "const": "rigid-tip3p-water" },
        "parameterFamilyId": {
          "type": "string",
          "const": "openmm-amber14-tip3p-joung-cheatham-explicit-solvent"
        },
        "parameterBytesEqualToCurrent851Receipt": { "type": "boolean", "const": true },
        "parameterByteEqualityImpliesExecution": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "composition": {
