    "backendPlan": { "$ref": "#/$defs/backendPlan" },
    "acceptancePlan": { "$ref": "#/$defs/acceptancePlan" },
    "evidenceSemantics": { "$ref": "#/$defs/evidenceSemantics" },
    "claimBoundaries": { "$ref": "#/$defs/claimBoundaries" }
