        "sodiumIonCount": { "type": "integer", "minimum": 0, "maximum": 0, "const": 0 },
        "chlorideIonCount": { "type": "integer", "minimum": 0, "maximum": 0, "const": 0 },
        "residueCount": { "type": "integer", "minimum": 895, "maximum": 895, "const": 895 },
        "particleCount": { "type": "integer", "minimum": 2685, "maximum": 2685, "const": 2685 },
        "topologyBondCount": { "type": "integer", "minimum": 1790, "maximum": 1790, "const": 1790 },
        "rigidDistanceConstraintCount": { "type": "integer", "minimum": 2685, "maximum": 2685, "const": 2685 },
        "intramolecularNonbondedExceptionCount": { "type": "integer", "minimum": 2685, "maximum": 2685, "const": 2685 },
        "totalMassDalton": {
          "type": "number",
          "minimum": 16123.71498,
          "maximum": 16123.71498,
          "const": 16123.71498
        },
        "totalChargeE": { "type": "number", "minimum": 0, "maximum": 0, "const": 0 },
        "nominalDensityKgM3": {
          "type": "number",
          "minimum": 991.6318008523569,
          "maximum": 991.6318008523569,
          "const": 991.6318008523569
        }
      },
      "additionalProperties": false
    },
    "cell": {
