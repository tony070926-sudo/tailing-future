        "x": { "type": "number", "minimum": 3, "maximum": 3, "const": 3 },
        "y": { "type": "number", "minimum": 0, "maximum": 0, "const": 0 },
        "z": { "type": "number", "minimum": 0, "maximum": 0, "const": 0 }
