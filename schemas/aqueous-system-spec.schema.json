        "cellDigest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "const": "sha256:f136d08ebff520542682222b0d6beb499e4710c854cb7dba842496d2817e5b84"
