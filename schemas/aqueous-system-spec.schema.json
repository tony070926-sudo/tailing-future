    "systemId",
    "systemDigest",
    "status",
    "identity",
    "composition",
    "cell",
    "inputs",
    "forceModel",
    "preparationPlan",
    "dynamicsPlan",
    "backendPlan",
    "acceptancePlan",
    "evidenceSemantics",
    "claimBoundaries"
