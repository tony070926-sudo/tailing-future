  "$id": "https://tailing.future/schemas/aqueous-system-spec/0.4.4",
  "title": "Tailing Future Aqueous System Specification v0.4.4",
  "description": "Closed declarative specification for the pinned 895-water OpenMM PME control plan. It does not represent an executed simulation.",
