        "sodiumIonCount",
        "chlorideIonCount",
        "residueCount",
        "particleCount",
        "topologyBondCount",
        "rigidDistanceConstraintCount",
        "intramolecularNonbondedExceptionCount",
        "totalMassDalton",
        "totalChargeE",
        "nominalDensityKgM3"
