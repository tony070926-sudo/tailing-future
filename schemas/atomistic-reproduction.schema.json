{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailing.future/schemas/atomistic-reproduction/0.1",
  "title": "Tailing Future Atomistic Reproduction Plan",
  "type": "object",
  "required": ["schemaVersion", "status", "frozenAt", "policy", "models", "benchmarks", "protocol", "excludedDefaults"],
  "properties": {
    "schemaVersion": { "const": "tf.atomistic-reproduction/0.1" },
    "status": { "const": "planned-not-reproduced" },
    "frozenAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "policy": { "type": "string", "minLength": 20 },
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/model" }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/benchmark" }
    },
    "protocol": { "$ref": "#/$defs/protocol" },
    "excludedDefaults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reason", "source", "revision", "gating", "license", "industrialDefaultAllowed", "restrictedCategories", "obligations", "legalEvidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 20 },
          "source": { "type": "string", "pattern": "^https://" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "gating": { "const": "manual" },
          "license": { "type": "string", "minLength": 10 },
          "industrialDefaultAllowed": { "const": false },
          "restrictedCategories": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
          "obligations": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 10 } },
          "legalEvidence": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["kind", "url", "sizeBytes", "gitBlobSha1", "sha256", "accessStatus"],
              "properties": {
                "kind": { "enum": ["model-card-and-embedded-use-policy", "license", "acceptable-use-policy"] },
                "url": { "type": "string", "pattern": "^https://" },
                "sizeBytes": { "type": "integer", "minimum": 1 },
                "gitBlobSha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "sha256": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
                "accessStatus": { "type": "string", "minLength": 5 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "model": {
      "type": "object",
      "required": ["id", "role", "evidenceClass", "sourceCommit", "sourceUrl", "license", "package", "checkpoint", "outputs", "intendedUse", "outOfScope", "levelOfTheory", "energyConvention", "defaultAliasAllowed", "cachePath"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["active", "challenger"] },
        "evidenceClass": { "const": "auditable" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "license": { "const": "MIT" },
        "package": {
          "type": "object",
          "required": ["name", "version", "filename", "url", "sizeBytes", "sha256", "pythonTag", "abiTag", "platformTag", "requiresPython", "cachePath"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "filename": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+\\.whl$" },
            "url": { "type": "string", "pattern": "^https://files\\.pythonhosted\\.org/" },
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/digest" },
            "pythonTag": { "type": "string", "minLength": 2 },
            "abiTag": { "type": "string", "minLength": 2 },
            "platformTag": { "type": "string", "minLength": 2 },
            "requiresPython": { "type": "string", "minLength": 4 },
            "cachePath": { "type": "string", "pattern": "^atomistic/packages/[A-Za-z0-9_.+-]+\\.whl$" }
          },
          "additionalProperties": false
        },
        "checkpoint": {
          "type": "object",
          "required": ["url", "sizeBytes", "sha256"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "sizeBytes": { "type": "integer", "minimum": 1000000 },
            "sha256": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        },
        "outputs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["energy_eV", "forces_eV_per_angstrom", "stress_eV_per_angstrom3"] }
        },
        "intendedUse": { "type": "string", "minLength": 20 },
        "outOfScope": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 10 } },
        "levelOfTheory": { "type": "string", "minLength": 20 },
        "energyConvention": { "type": "string", "minLength": 20 },
        "defaultAliasAllowed": { "const": false },
        "cachePath": { "type": "string", "pattern": "^atomistic/[A-Za-z0-9_.+-]+$" }
      },
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "required": ["id", "role", "evidenceClass", "source", "sourceCommit", "license", "redistribute", "artifact"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary-like-for-like", "independent-stability"] },
        "evidenceClass": { "enum": ["auditable", "reference"] },
        "source": { "type": "string", "pattern": "^https://" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 2 },
        "redistribute": { "type": "boolean" },
        "artifact": {
          "type": "object",
          "required": ["url", "sha256"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "sha256": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
            "frames": { "type": "integer", "minimum": 1 },
            "atoms": { "type": "integer", "minimum": 1 },
            "elements": { "type": "integer", "minimum": 1 },
            "smokeIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "smokeManifestSha256": { "$ref": "#/$defs/digest" },
            "recordManifestSha256": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        },
        "cachePath": { "type": "string", "pattern": "^atomistic/[A-Za-z0-9_.+-]+$" },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 10 } }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": ["runner", "integrity", "metrics", "invariance", "randomTpAcceptance", "mdSmoke", "abstention"],
      "properties": {
        "runner": { "type": "object" },
        "integrity": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "metrics": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "invariance": { "type": "object" },
        "randomTpAcceptance": { "type": "object" },
        "mdSmoke": { "type": "object" },
        "abstention": { "type": "array", "minItems": 3, "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
