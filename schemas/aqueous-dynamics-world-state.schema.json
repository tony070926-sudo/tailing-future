{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailing.future/schemas/aqueous-dynamics-world-state/0.4.2",
  "title": "Tailing Future Solver-Driven Aqueous Dynamics World State",
  "$comment": "Semantic-validator scope: verify every SHA-256 digest binding; revision/step/time progression; parent, action, and receipt identity links; fromStep/toStep relationships; energy-statistics relationships; and solverIntegratorWorkUnits + composerEndpointRankAuditWorkUnits = totalIntegrationWorkUnits.",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "worldId",
    "stateId",
    "stateDigest",
    "physicalDigest",
    "parentStateId",
    "revision",
    "step",
    "timePicoseconds",
    "configurationDigest",
    "topologyDigest",
    "configuration",
    "atoms",
    "initialTotalEnergyKjMol",
    "initialMassDalton",
    "initialChargeE",
    "initialMomentumDaltonAngstromPerPicosecond",
    "energyReferenceKjMol",
    "energyStatistics",
    "lastIntegrationReceipt",
    "lastAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tf.aqueous-dynamics-world-state/0.4.2"
    },
    "status": {
      "const": "solver-driven-finite-size-integration-calibration"
    },
    "worldId": {
      "const": "nacl-tip3p-finite-size-calibration"
    },
    "stateId": {
      "$ref": "#/$defs/token"
    },
    "stateDigest": {
      "$ref": "#/$defs/digest"
    },
    "physicalDigest": {
      "$ref": "#/$defs/digest"
    },
    "parentStateId": {
      "oneOf": [
        {
          "$ref": "#/$defs/token"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "$ref": "#/$defs/nonnegativeSafeInteger"
    },
    "step": {
      "$ref": "#/$defs/nonnegativeSafeInteger"
    },
    "timePicoseconds": {
      "$ref": "#/$defs/nonnegativeFinite"
    },
    "configurationDigest": {
      "const": "sha256:37dc2a135bb5c7d76be2166d5967cafe7819c65663358754e487b21564e8187b"
    },
    "topologyDigest": {
      "const": "sha256:53efaac1f1e0bf643f0ab99bec32c02d9dfdf9a0eb32fafc8b9d371d45fda667"
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "atoms": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "$ref": "#/$defs/atomStateChloride"
        },
        {
          "$ref": "#/$defs/atomStateSodium"
        },
        {
          "$ref": "#/$defs/atomStateWaterAH1"
        },
        {
          "$ref": "#/$defs/atomStateWaterAH2"
        },
        {
          "$ref": "#/$defs/atomStateWaterAO"
        },
        {
          "$ref": "#/$defs/atomStateWaterBH1"
        },
        {
          "$ref": "#/$defs/atomStateWaterBH2"
        },
        {
          "$ref": "#/$defs/atomStateWaterBO"
        }
      ],
      "items": false
    },
    "initialTotalEnergyKjMol": {
      "$ref": "#/$defs/finite"
    },
    "initialMassDalton": {
      "$ref": "#/$defs/positiveFinite"
    },
    "initialChargeE": {
      "$ref": "#/$defs/finite"
    },
    "initialMomentumDaltonAngstromPerPicosecond": {
      "$ref": "#/$defs/vector"
    },
    "energyReferenceKjMol": {
      "$ref": "#/$defs/positiveFinite"
    },
    "energyStatistics": {
      "$ref": "#/$defs/energyStatistics"
    },
    "lastIntegrationReceipt": {
      "oneOf": [
        {
          "$ref": "#/$defs/integrationReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastAction": {
      "oneOf": [
        {
          "$ref": "#/$defs/lastAction"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "step"
        ],
        "properties": {
          "step": {
            "const": 0
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "parentStateId": {
            "type": "null"
          },
          "revision": {
            "const": 0
          },
          "timePicoseconds": {
            "const": 0
          },
          "lastIntegrationReceipt": {
            "type": "null"
          },
          "lastAction": {
            "type": "null"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "parentStateId": {
            "$ref": "#/$defs/token"
          },
          "lastIntegrationReceipt": {
            "$ref": "#/$defs/integrationReceipt"
          },
          "lastAction": {
            "$ref": "#/$defs/lastAction"
          }
        }
      }
    }
