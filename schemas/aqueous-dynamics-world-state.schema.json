      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "z": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
