      "properties": {
        "x": {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "y": {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "z": {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      },
      "additionalProperties": false
