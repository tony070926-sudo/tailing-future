    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "finite": {
      "type": "number",
      "minimum": -1e+300,
      "maximum": 1e+300
    },
    "nonnegativeFinite": {
      "type": "number",
      "minimum": 0,
      "maximum": 1e+300
    },
    "positiveFinite": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1e+300
    },
    "nonnegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "vector": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/finite"
